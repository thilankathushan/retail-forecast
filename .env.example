# Docker Compose reads .env automatically. Copy this file to .env if needed.
# The directory must already contain bundle.json AND manifest.json.
RETAIL_ARTIFACT_DIR=./artifacts/uci/application
RETAIL_API_PORT=8000
RETAIL_DASHBOARD_PORT=8501
# Native application overrides must be exported in the shell (not auto-loaded).
# export RETAIL_API_URL=http://127.0.0.1:8000
# export RETAIL_APP_BUNDLE=/absolute/path/to/application/bundle.json
# No credentials or external services are required.
